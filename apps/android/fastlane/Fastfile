# Android release lanes. Runbook: docs/release-android.md
# Run from apps/android: `bundle exec fastlane <lane>` (or `fastlane <lane>`).
default_platform(:android)

AAB = "app/build/outputs/bundle/release/app-release.aab"
TRACKS = %w[internal alpha beta production].freeze
# Same names as Screengrab.screenshot(...) in ListingScreenshots.kt.
SCREENSHOTS = %w[1_album 2_photo 3_desktop].freeze
SHOTS_DIR = File.expand_path("metadata/android/en-US/images/phoneScreenshots", __dir__)
CHANGELOGS_DIR = File.expand_path("metadata/android/en-US/changelogs", __dir__)
RELEASE_NOTE_SCRIPT = File.expand_path("../../../scripts/release-note.mjs", __dir__)

# nil when dir holds exactly the expected PNGs at sizes Play accepts, else the reason.
def screenshot_problem(dir)
  found = Dir.exist?(dir) ? Dir.children(dir).sort : []
  expected = SCREENSHOTS.map { |name| "#{name}.png" }
  return "Store screenshots: expected #{expected.join(", ")} in #{dir}; found #{found.join(", ")}" unless found == expected
  expected.each do |file|
    w, h = File.binread(File.join(dir, file), 24).unpack("@16N2")
    next if w && h && [w, h].all? { |side| side.between?(320, 3840) } && [w, h].max <= 2 * [w, h].min
    return "Store screenshot #{file} is #{w}x#{h}; Play needs 320-3840 px per side and the long side at most twice the short side"
  end
  nil
end

platform :android do
  desc "Next versionCode: one above the highest code on any Play track"
  private_lane :next_version_code do
    codes = TRACKS.flat_map do |track|
      google_play_track_version_codes(track: track)
    rescue StandardError
      [] # track has no releases yet
    end
    (codes.max || 0) + 1
  end

  desc "Build the signed bundle. Options: version_code, version_name"
  lane :build do |options|
    ENV["JUSTUS_VERSION_CODE"] = options[:version_code].to_s if options[:version_code]
    ENV["JUSTUS_VERSION_NAME"] = options[:version_name] if options[:version_name]
    gradle(task: "bundle", build_type: "Release", project_dir: ".")
    sh("jarsigner", "-verify", File.expand_path("../#{AAB}", __dir__)) do |status, result|
      UI.user_error!("#{AAB} is unsigned: set the JUSTUS_UPLOAD_* keystore") unless status.success? && result.include?("jar verified")
    end
    readelf = Dir[File.join(ENV.fetch("ANDROID_HOME", ""), "ndk/*/toolchains/llvm/prebuilt/*/bin/llvm-readelf")].max
    readelf ||= "llvm-readelf"
    sh({ "READELF" => readelf }, File.expand_path("../../../scripts/check-aab-page-size.sh", __dir__), File.expand_path("../#{AAB}", __dir__))
  end

  desc "Write the one-line release note for a version code to changelogs/<code>.txt"
  private_lane :write_release_note do |options|
    note = sh("node", RELEASE_NOTE_SCRIPT, log: false).strip
    FileUtils.mkdir_p(CHANGELOGS_DIR)
    File.write(File.join(CHANGELOGS_DIR, "#{options[:code]}.txt"), "#{note}\n")
    UI.message("Release note for #{options[:code]}: #{note}")
  end

  desc "Build and upload to the internal track, then the listing. Options: version_name"
  lane :internal do |options|
    code = next_version_code
    build(version_code: code, version_name: options[:version_name])
    write_release_note(code: code)
    upload_to_play_store(
      track: "internal",
      aab: AAB,
      skip_upload_apk: true, # ignore stray debug APKs from earlier builds
      # Play only accepts drafts until the app has been reviewed and published once.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    begin
      listing
    rescue StandardError => e
      UI.user_error!("Build #{code} is on the internal track, but the listing upload failed: #{e.message}")
    end
  end

  desc "Take the Play listing screenshots on the attached emulator. Options: serial"
  lane :screenshots do |options|
    gradle(tasks: [":app:assembleDebug", ":app:assembleDebugAndroidTest"], project_dir: ".")
    screengrab(
      app_package_name: "no.cankode.justus",
      tests_package_name: "no.cankode.justus.test",
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
      use_tests_in_classes: ["io.justus.app.ListingScreenshots"],
      test_instrumentation_runner: "androidx.test.runner.AndroidJUnitRunner",
      locales: ["en-US"],
      output_directory: "fastlane/metadata/android",
      clear_previous_screenshots: true,
      use_timestamp_suffix: false,
      reinstall_app: true,
      exit_on_test_failure: true,
      skip_open_summary: true,
      specific_device: options[:serial]
    )
    problem = screenshot_problem(SHOTS_DIR)
    UI.user_error!(problem) if problem
  end

  desc "Upload the store listing (text, icon, screenshots) from fastlane/metadata (no build)"
  lane :listing do
    problem = screenshot_problem(SHOTS_DIR)
    UI.important("Skipping screenshots: #{problem}. Play keeps its current screenshots.") if problem
    # supply looks up a release even when changelogs are skipped, and a blank
    # version_code slips through its empty-check (supply/uploader.rb:90). Point
    # it at the newest internal build; nothing about that release changes.
    upload_to_play_store(
      track: "internal",
      version_code: google_play_track_version_codes(track: "internal").max,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_screenshots: !problem.nil?
    )
  end

  desc "Promote the latest build. Options: from (internal), to (production), rollout (0.1)"
  lane :promote do |options|
    to = options[:to] || "production"
    upload_to_play_store(
      track: options[:from] || "internal",
      track_promote_to: to,
      rollout: to == "production" ? (options[:rollout] || "0.1").to_s : nil,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Raise the staged production rollout. Options: rollout (e.g. 0.5, 1)"
  lane :rollout do |options|
    upload_to_play_store(
      track: "production",
      rollout: options[:rollout].to_s,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
