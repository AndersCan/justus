<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing leaves the device: the storage dir holds drive secret
     keys and photos, and a restored key would make two devices write one
     single-writer drive. Recovery is "rejoin with a new invite". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
