{
  "name": "justus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "start:mac": "node apps/desktop/scripts/build.mjs && open apps/desktop/dist/Justus.app",
    "check:issue-refs": "node scripts/check-issue-refs.mjs",
    "test": "vp test run scripts",
    "test:e2e": "playwright test",
    "test:bare": "pnpm --filter @justus/backend run test:bare",
    "test:e2e-hub": "vitest run --config e2e/hub/vitest.config.ts",
    "test:e2e-p2p": "playwright test --config playwright.hub.config.ts",
    "test:e2e-hub:plan": "node scripts/e2e-hub.mjs --plan",
    "test:native": "bash scripts/maestro-e2e.sh",
    "prepare": "vp config",
    "flows:build": "astro build --config docs/flows/astro.config.mjs",
    "flows:dev": "node scripts/flows-dev.mjs",
    "dev:peers": "JUSTUS_PEERS=2 pnpm --parallel --filter './apps/*' run dev"
  },
  "devDependencies": {
    "@mantaq/inspect": "catalog:",
    "@mantaq/viz": "catalog:",
    "@playwright/test": "catalog:",
    "astro": "catalog:",
    "require-asset": "^1.2.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
