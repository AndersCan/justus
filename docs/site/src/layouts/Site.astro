---
const { title } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Justus</title>
  </head>
  <body>
    <nav>
      <a href={home}>Justus</a> · <a href={`${home}flows/`}>Flows</a> · <a href={`${home}privacy/`}>Privacy</a>
    </nav>
    <h1>{title}</h1>
    <slot />
  </body>
</html>
