---
const { title } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} · Justus flows</title>
  </head>
  <body>
    <p><a href={home}>All flows</a></p>
    <h1>{title}</h1>
    <slot />
  </body>
</html>
